__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# LaTeX build intermediates (compiled PDFs and .bbl are kept).
*.aux
*.blg
*.fdb_latexmk
*.fls
*.out
*.spl
*.xdv
