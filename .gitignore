# Generated training/evaluation artifacts stay local.  The small, curated
# remote-resume bundle is stored separately under remote_resume/.
/outputs/
/backup_before_aug/
*.log
*.logtmux

# Local backups of selected checkpoints (large binaries).
/models/
/remote_resume/**/checkpoints/*.pt
# Native build intermediates (the LKH binary itself is kept).
*.o
